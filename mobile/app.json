{
  "expo": {
    "name": "AiQonaq",
    "slug": "ai-arenda",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "aiarenda",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.aiarenda.assistant"
    },
    "android": {
      "package": "app.aiarenda.assistant",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      }
    },
    "web": {
      "name": "AiQonaq — мобильное приложение",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите выбрать фотографии жилья и фото профиля.",
          "cameraPermission": "Разрешите снять фото объекта или профиля по вашему запросу.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите определить ваше положение, чтобы вести вас к объекту по карте приложения.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1B4B",
          "image": "./assets/brand/launch-blank.png",
          "imageWidth": 8
        }
      ]
    ]
  }
}
